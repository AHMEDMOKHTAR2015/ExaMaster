{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    // One route + cluster per service. The service prefix is stripped: /quizmaster/api/me -> http://quizmaster/api/me
    "Routes": {
      "quizmaster-service": {
        "ClusterId": "quizmaster-cluster",
        "Match": { "Path": "/quizmaster/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/quizmaster" } ]
      }
    },
    "Clusters": {
      "quizmaster-cluster": {
        "Destinations": {
          "quizmaster": { "Address": "http://localhost:4401" }
        }
      }
    }
  }
}
