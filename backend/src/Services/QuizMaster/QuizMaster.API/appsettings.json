{
  // Placeholders only. Real values come from appsettings.Development.json (local), user-secrets, or environment variables.
  // Never commit real secrets here.
  "ConnectionStrings": {
    "Database": ""
  },
  "AuthTokenOptions": {
    // The tokens this API issues at sign-in. SigningKey is a secret of at least 32 characters: set it per environment
    // (AuthTokenOptions__SigningKey). Left empty here, the API refuses to start until it is.
    "Issuer": "QuizMasterPro",
    "Audience": "QuizMasterPro.App",
    "SigningKey": ""
  },
  "PlatformAdministratorOptions": {
    // The one account created on first start of an empty database. Password is a secret: set it per environment
    // (PlatformAdministratorOptions__Password). Left empty, no account is created and a warning is logged.
    "Email": "platform@quizmasterpro.local",
    "Password": ""
  },
  "ClientAppOptions": {
    // Where the app is served from, for CORS. A placeholder until hosting is decided: set it per environment
    // (ClientAppOptions__AllowedOrigins__0=https://…).
    "AllowedOrigins": [
      "https://app.quizmaster.invalid"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
