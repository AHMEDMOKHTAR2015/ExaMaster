              "raw": "{\n  \"bankQuizId\": {{quizId}},\n  \"responses\": [\n    {\n      \"questionId\": 1,\n      \"selectedOptionId\": 1\n    },\n    {\n      \"questionId\": 2,\n      \"selectedOptionId\": 1\n    },\n    {\n      \"questionId\": 3,\n      \"blanks\": [\n        {\n          \"index\": 0,\n          \"userAnswer\": \"photosynthesis\"\n        },\n        {\n          \"index\": 1,\n          \"userAnswer\": \"light\"\n        }\n      ]\n    },\n    {\n      \"questionId\": 4,\n      \"responseText\": \"<p>The axis is tilted.</p>\"\n    }\n  ]\n}",
